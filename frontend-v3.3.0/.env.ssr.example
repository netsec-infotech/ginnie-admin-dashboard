# Copy to .env.production.local in the Git checkout on the server.
# This local file is ignored by Git. Do not put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_SSR=true
NEXT_PUBLIC_ADMIN_PANEL_URL=https://admin.example.com
NEXT_PUBLIC_SITE_URL=https://shop.example.com

# Fallback X-Locale for API requests without an explicit/selected language.
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Add any deployment-specific Firebase and other public settings used by .env.
# Use literal values here (no ${VARIABLE} interpolation).
